# US production target. Copy to .env.prod-us.local.
# For .env.prod-eu.local, use EU IDs, URLs, region, analytics and sandbox values.
# Runtime secrets belong only in the corresponding Convex deployment.
# Each target uses its own GitHub, Slack, Linear and Notion registrations and
# credentials. Follow docs/integrations.md for provider setup and branding.
# Run from pushed main: pnpm ship prod-us (or prod-eu).
# Vercel CLI supplies authentication; these IDs select the exact project.
CONVEX_DEPLOYMENT=prod:DEPLOYMENT_NAME
CONVEX_DEPLOY_KEY=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Exact cloud/site URLs from Convex. Ireland includes .eu-west-1 before
# .convex.cloud or .convex.site. Match these public values in Vercel.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_JORI_REGION=us
VITE_JORI_ENABLED_REGIONS=eu,us
VITE_JORI_PUBLIC_ORIGIN=https://usejori.com
VITE_JORI_EU_ORIGIN=https://eu.usejori.com
VITE_JORI_US_ORIGIN=https://us.usejori.com
VITE_POSTHOG_ENABLED=true
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=

# Set BL_API_KEY, BL_WORKSPACE, JORI_BLAXEL_IMAGE and DO_NOT_TRACK=1 in
# the matching Convex deployment. Build the image with pnpm sandbox <target>.
# See docs/sandboxes.md before configuring or rolling out this trial.
