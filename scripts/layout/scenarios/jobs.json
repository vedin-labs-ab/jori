[
  {
    "id": "C114-additional-open",
    "title": "Job additional access opens tools dialog",
    "path": "http://127.0.0.1:5192/scripts/layout/states/page.html?case=jobs-access",
    "target": "app",
    "anonymous": true,
    "mutating": true,
    "setup": [],
    "steps": [
      {
        "action": "click",
        "selector": "button[aria-label^=\"GitHub additional access:\"]"
      }
    ],
    "ready": [
