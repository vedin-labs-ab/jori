# Production environment. Copy to .env.prod.local.
#
# This file holds credentials that TARGET production, never the secrets
# production RUNS ON. Application secrets live in the Convex and Vercel
# dashboards so a developer machine never has to hold them, and
# `pnpm deploy:prod` verifies the deployment has them before it deploys.

# Convex production deploy key. Create it with:
#
#   npx convex deployment token create local-deploy --prod \
#     --save-env .env.prod.local
#
# The Vercel CLI is not configured here. It carries its own credentials from
# `vercel login` and reads the linked project from `.vercel/`, which
# `vercel link` writes once per checkout.
CONVEX_DEPLOY_KEY=

# Template names are global to the E2B team, so each environment names its
# own and there is no default. Only needed for `pnpm sandbox:build:prod`.
JORI_E2B_TEMPLATE=jori-sandbox-prod
E2B_API_KEY=
