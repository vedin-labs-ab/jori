# Regional target template. Copy to .env.prod.eu.local and .env.prod.us.local.
# Runtime secrets belong only in the corresponding Convex deployment.
# Run from checked, pushed main: pnpm deploy:prod --region eu (or us).
# Vercel CLI supplies authentication; these IDs select the exact project.
CONVEX_DEPLOYMENT=prod:DEPLOYMENT_NAME
CONVEX_DEPLOY_KEY=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Exact cloud/site URLs from Convex. Ireland includes .eu-west-1 before
# .convex.cloud or .convex.site. Match these public values in Vercel.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_JORI_REGION=eu
VITE_JORI_ENABLED_REGIONS=eu,us
VITE_JORI_PUBLIC_ORIGIN=https://usejori.com
VITE_JORI_EU_ORIGIN=https://eu.usejori.com
VITE_JORI_US_ORIGIN=https://us.usejori.com
VITE_POSTHOG_ENABLED=true
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=

# Supply the matching E2B key securely to the template build process.
JORI_E2B_TEMPLATE=jori-production-eu
# E2B_DOMAIN=e2b.app
