{
  "name": "milo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm runtime:check && pnpm prompts:compile && pnpm check:typecheck && vite build",
    "check": "pnpm runtime:check && pnpm prompts:compile && pnpm check:structure && pnpm check:dependencies && pnpm check:biome && pnpm check:typecheck",
    "check:biome": "biome ci --error-on-warnings .",
    "check:dependencies": "node --experimental-strip-types scripts/dependencies.ts",
    "check:fix": "biome check --write .",
    "check:structure": "node --experimental-strip-types scripts/structure.ts",
    "check:typecheck": "tsc --noEmit",
    "deploy": "pnpm runtime:check && pnpm prompts:compile && node --experimental-strip-types scripts/env.ts npx convex dev --once --configure existing --team vedin-labs --project milo --dev-deployment cloud && pnpm skills:sync",
    "e2b:build": "node --experimental-strip-types scripts/e2b.ts",
    "convex:truncate": "node --experimental-strip-types scripts/truncate.ts",
    "preview": "vite preview",
    "skills:sync": "node --experimental-strip-types scripts/env.ts npx convex run skills/catalog:syncGlobalSkills",
    "prompts:compile": "node scripts/prompts.ts && biome format --write convex/prompts/generated.ts",
    "runtime:check": "node --experimental-strip-types scripts/runtime.ts --check",
    "runtime:generate": "node --experimental-strip-types scripts/runtime.ts",
    "trigger:dev": "node --experimental-strip-types scripts/env.ts trigger dev --env-file .env.local",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@clerk/tanstack-react-start": "^1.3.3",
    "@clerk/ui": "^1.15.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@openrouter/sdk": "^0.12.79",
    "@radix-ui/react-dismissable-layer": "^1.1.12",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@tiptap/core": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@trigger.dev/sdk": "^4.4.6",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.40.0",
    "date-fns": "^4.4.0",
    "e2b": "^2.28.0",
    "embla-carousel-react": "^8.6.0",
    "exa-js": "^2.14.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^28",
    "trigger.dev": "^4.4.6",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
