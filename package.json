{
  "name": "milo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm runtime:check && pnpm templates:check && pnpm content:compile && pnpm check:typecheck && vite build",
    "check": "pnpm runtime:check && pnpm templates:check && pnpm content:compile && pnpm check:structure && pnpm check:dependencies && pnpm check:versions && pnpm check:entrypoints && pnpm check:drift && pnpm check:biome && pnpm check:typecheck",
    "templates:check": "tsx scripts/templates.ts --check",
    "templates:compile": "tsx scripts/templates.ts",
    "check:biome": "biome ci --error-on-warnings .",
    "check:dependencies": "node --experimental-strip-types scripts/dependencies.ts",
    "check:drift": "node --experimental-strip-types scripts/drift.ts",
    "check:entrypoints": "node --experimental-strip-types scripts/entrypoints.ts",
    "check:fix": "biome check --write .",
    "check:structure": "node --experimental-strip-types scripts/structure/index.ts",
    "check:typecheck": "tsc --noEmit",
    "deploy": "pnpm runtime:check && pnpm templates:check && pnpm content:compile && pnpm check:typecheck && node --experimental-strip-types scripts/env.ts npx convex dev --once --configure existing --team vedin-labs --project milo --dev-deployment cloud && pnpm skills:sync",
    "e2b:build": "node --experimental-strip-types scripts/e2b.ts",
    "convex:truncate": "node --experimental-strip-types scripts/truncate.ts",
    "preview": "vite preview",
    "skills:sync": "node --experimental-strip-types scripts/env.ts npx convex run skills/catalog:syncGlobalSkills",
    "content:compile": "node scripts/prompts/index.ts && node scripts/skills/index.ts && biome format --write prompts/generated.ts skills/generated.ts",
    "runtime:check": "node --experimental-strip-types scripts/runtime/index.ts --check",
    "runtime:generate": "node --experimental-strip-types scripts/runtime/index.ts",
    "trigger:dev": "node --experimental-strip-types scripts/env.ts trigger dev --env-file .env.local",
    "test": "vitest run",
    "check:versions": "node --experimental-strip-types scripts/versions.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/tanstack-react-start": "^1.4.12",
    "@clerk/ui": "^1.24.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@openrouter/sdk": "^0.13.24",
    "@radix-ui/react-dismissable-layer": "^1.1.14",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-code": "^3.27.3",
    "@tiptap/extension-code-block-lowlight": "^3.27.3",
    "@tiptap/extension-paragraph": "^3.27.3",
    "@tiptap/markdown": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@trigger.dev/sdk": "^4.5.0",
    "ai": "^6.0.219",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "date-fns": "^4.4.0",
    "e2b": "^2.31.0",
    "embla-carousel-react": "^8.6.0",
    "emoji-datasource": "^16.0.0",
    "exa-js": "^2.16.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "liquidjs": "^10.27.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "marked": "^17.0.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.9.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^18.0.0",
    "jsdom": "^29.1.1",
    "trigger.dev": "^4.5.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
