  "scripts": {
    "brand": "node --experimental-strip-types scripts/brand/index.ts",
    "brand:social": "node --experimental-strip-types scripts/brand/capture.ts",
    "dev": "pnpm dev:convex --start \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:convex": "node --experimental-strip-types scripts/env/index.ts dev -- npx convex dev",
    "dev:check": "node --experimental-strip-types scripts/dev/index.ts check",
    "dev:up": "node --experimental-strip-types scripts/dev/index.ts up",
    "dev:down": "node --experimental-strip-types scripts/dev/index.ts down",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --experimental-strip-types scripts/check.ts",
    "check:biome": "biome ci --error-on-warnings .",
    "check:bundle": "env JORI_BUNDLE_CHECK=1 vite build --logLevel error",
    "check:content": "node --experimental-strip-types scripts/content/index.ts",
    "check:dependencies": "node --experimental-strip-types scripts/dependencies/index.ts",
    "check:entrypoints": "node --experimental-strip-types scripts/entrypoints.ts",
    "check:fix": "pnpm content:compile && biome check --write .",
    "check:structure": "node --experimental-strip-types scripts/structure/index.ts",
    "check:typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "check:versions": "node --experimental-strip-types scripts/versions.ts",
    "content:compile": "node --experimental-strip-types scripts/content/index.ts --write",
    "test": "node --experimental-strip-types scripts/test.ts",
    "task": "node --experimental-strip-types scripts/worktree/start.ts",
    "land": "node --experimental-strip-types scripts/worktree/land.ts",
    "backend": "node --experimental-strip-types scripts/worktree/backend.ts",
    "ship": "node --experimental-strip-types scripts/deploy.ts",
    "skills": "node --experimental-strip-types scripts/env/task.ts skills",
    "sandbox": "node --experimental-strip-types scripts/env/task.ts sandbox",
    "db:seed": "node --experimental-strip-types scripts/env/task.ts seed",
    "db:truncate": "node --experimental-strip-types scripts/env/task.ts truncate",
    "layout": "node --experimental-strip-types scripts/layout/index.ts",
    "layout:fixture": "node --experimental-strip-types scripts/layout/server.ts",
    "layout:states": "node --experimental-strip-types scripts/layout/states/server.ts",
    "layout:app": "node --experimental-strip-types scripts/layout/app.ts"
