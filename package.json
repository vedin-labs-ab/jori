{
  "name": "jori",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:web": "vite",
    "dev:convex": "node --experimental-strip-types scripts/env/index.ts --env dev -- npx convex dev",
    "dev:trigger": "node --experimental-strip-types scripts/env/index.ts --env dev -- npx trigger dev --env-file .env.local",
    "build": "vite build",
    "check": "node --experimental-strip-types scripts/check.ts",
    "check:biome": "biome ci --error-on-warnings .",
    "check:bundle": "vite build --logLevel error",
    "check:dependencies": "node --experimental-strip-types scripts/dependencies.ts",
    "check:entrypoints": "node --experimental-strip-types scripts/entrypoints.ts",
    "check:fix": "biome check --write .",
    "check:structure": "node --experimental-strip-types scripts/structure/index.ts",
    "check:typecheck": "tsc --noEmit",
    "check:versions": "node --experimental-strip-types scripts/versions.ts",
    "deploy:dev": "pnpm check && node --experimental-strip-types scripts/env/index.ts --env dev -- npx convex dev --once && pnpm skills:sync:dev",
    "deploy:prod": "node --experimental-strip-types scripts/deploy.ts",
    "sandbox:build:dev": "node --experimental-strip-types scripts/env/index.ts --env dev -- node --experimental-strip-types scripts/e2b.ts",
    "sandbox:build:prod": "node --experimental-strip-types scripts/env/index.ts --env prod -- node --experimental-strip-types scripts/e2b.ts",
    "skills:sync:dev": "node --experimental-strip-types scripts/env/index.ts --env dev -- npx convex run skills/catalog:syncGlobalSkills",
    "skills:sync:prod": "node --experimental-strip-types scripts/env/index.ts --env prod -- npx convex run skills/catalog:syncGlobalSkills",
    "db:truncate:dev": "node --experimental-strip-types scripts/env/index.ts --env dev -- node --experimental-strip-types scripts/truncate.ts",
    "preview": "vite preview",
    "content:compile": "node --experimental-strip-types scripts/content/index.ts",
    "test": "node --experimental-strip-types scripts/gate.ts vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "^1.6.27",
    "@better-auth-ui/react": "^1.6.27",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@openrouter/sdk": "^1.0.0",
    "@radix-ui/react-dismissable-layer": "^1.1.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-code": "^3.28.0",
    "@tiptap/extension-code-block-lowlight": "^3.28.0",
    "@tiptap/extension-paragraph": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@trigger.dev/sdk": "^4.5.6",
    "ai": "^7.0.33",
    "better-auth": "1.6.23",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.3",
    "date-fns": "^4.4.0",
    "e2b": "^2.35.0",
    "emoji-datasource": "^16.0.0",
    "exa-js": "^2.16.0",
    "highlight.js": "^11.11.1",
    "liquidjs": "^10.27.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "posthog-js": "^1.407.3",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^29.1.1",
    "trigger.dev": "^4.5.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
