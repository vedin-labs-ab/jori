CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Trigger.dev worker envs.
CONVEX_URL=
CONVEX_SITE_URL=
TRIGGER_PROJECT_REF=
TRIGGER_DEV_API_KEY=
MILO_WORKER_SECRET=
OPENAI_API_KEY=
MILO_OPENAI_MODEL=gpt-4.1
E2B_API_KEY=
MILO_E2B_TEMPLATE=milo-codex

# Convex deployment envs, not Vite envs. Set them with:
# Optional explicit app origin for artifact links. If omitted, Milo uses the
# first MILO_ARTIFACT_FRAME_ANCESTORS origin.
# pnpm exec convex env set MILO_APP_URL "http://localhost:5173"
# pnpm exec convex env set MILO_ARTIFACT_FRAME_ANCESTORS "http://localhost:5173"
MILO_APP_URL=
MILO_ARTIFACT_FRAME_ANCESTORS=
OPENROUTER_API_KEY=
OPENROUTER_ARTIFACT_MODEL=z-ai/glm-5.2

# Required for signed Notion webhook event deliveries after subscription verification.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Optional when VITE_CLERK_PUBLISHABLE_KEY is present.
CLERK_JWT_ISSUER_DOMAIN=
