# Development environment. Copy to .env.local.
#
# Bootstrap a new checkout once with `npx convex dev --configure`, which
# creates the deployment and writes CONVEX_DEPLOYMENT for you. Task worktrees
# read this file from the primary checkout, so it is written once per machine.

CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Frontend deployment identity. Local development defaults to this US-only
# topology when these values are omitted. Production builds require them.
VITE_JORI_REGION=us
VITE_JORI_ENABLED_REGIONS=us
VITE_JORI_PUBLIC_ORIGIN=http://localhost:5173
VITE_JORI_US_ORIGIN=http://localhost:5173
# VITE_JORI_EU_ORIGIN=https://eu.example.com

# Trigger.dev worker envs.
CONVEX_URL=
CONVEX_SITE_URL=
TRIGGER_PROJECT_REF=
TRIGGER_DEV_API_KEY=
JORI_WORKER_SECRET=
OPENROUTER_API_KEY=
E2B_API_KEY=

# Template names are global to the E2B team, so each environment names its
# own and there is no default.
JORI_E2B_TEMPLATE=jori-sandbox-dev

# Convex deployment envs, not Vite envs. Set them on the deployment with:
#
#   npx convex env set JORI_APP_URL "http://localhost:5173"
#   npx convex env set JORI_REGION "us"
#   npx convex env set JORI_APP_FRAME_ANCESTORS "http://localhost:5173"
#
# Better Auth runs inside the Convex deployment and needs its own deployment
# envs: BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET, RESEND_API_KEY, and
# JORI_APP_URL as the app origin. Sign-in resolves every social credential on
# each request, so a missing Microsoft secret breaks Google sign-in too.
#
# JORI_EMAIL_FROM falls back to Resend's shared test domain, which only
# delivers to the account owner. Set it before sending anything real.
#
# NOTION_WEBHOOK_VERIFICATION_TOKEN is required for signed Notion webhook
# deliveries after subscription verification.
