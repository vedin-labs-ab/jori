# Convex deployment selected by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Client-side Convex URLs.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Client-side Clerk key.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk JWT issuer URL used by `convex/auth.config.ts` during Convex deploys.
# Example: https://example.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
