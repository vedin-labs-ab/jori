CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Frontend deployment identity. Local development defaults to this US-only
# topology when these values are omitted. Production builds require them.
VITE_JORI_REGION=us
VITE_JORI_ENABLED_REGIONS=us
VITE_JORI_PUBLIC_ORIGIN=http://localhost:5173
VITE_JORI_US_ORIGIN=http://localhost:5173
# VITE_JORI_EU_ORIGIN=https://eu.example.com

# Trigger.dev worker envs.
CONVEX_URL=
CONVEX_SITE_URL=
TRIGGER_PROJECT_REF=
TRIGGER_DEV_API_KEY=
JORI_WORKER_SECRET=
OPENROUTER_API_KEY=
E2B_API_KEY=
JORI_E2B_TEMPLATE=jori-sandbox

# Convex deployment envs, not Vite envs. Set them with:
# Optional explicit Jori origin for app links. If omitted, Jori uses the
# first JORI_APP_FRAME_ANCESTORS origin.
# pnpm exec convex env set JORI_APP_URL "http://localhost:5173"
# pnpm exec convex env set JORI_REGION "us"
# pnpm exec convex env set JORI_APP_FRAME_ANCESTORS "http://localhost:5173"
JORI_REGION=us
JORI_APP_URL=
JORI_APP_FRAME_ANCESTORS=

# Required for signed Notion webhook event deliveries after subscription verification.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Better Auth runs inside the Convex deployment. It needs these deployment
# envs (not Vite envs): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET,
# RESEND_API_KEY, and JORI_APP_URL as the app origin.
